---
import Layout from "@/layouts/Layout.astro";
import { krambambouliService } from "@/lib/services/krambambouli";
import { getLocale } from "@/lib/utils";
import KrambambouliOrderList from "@/components/app/krambambouli/KrambambouliOrderList";
import type { Page } from "@/lib/domain/page";
import type { OrderData } from "@/lib/domain/krambambouli";

const title = "Dashbambouli";
const page: Page<OrderData> = await krambambouliService.getOrders();
const locale = getLocale(Astro.request);
---

<Layout title={title}>
  <KrambambouliOrderList page={page} locale={locale} client:load />
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import CodexChallengePage from "@/components/web/codex-challenge/CodexChallengePage.astro";
import { getCollection } from "astro:content";

const title = "Codex Challenge";
const songCollection = await getCollection("songs");
const songs = songCollection.map((song) => song.data);
const songsGroupedByLang = Object.groupBy(songs, (song) => song.language);
const otherSongs = [
  ...(songsGroupedByLang.Engels ?? []),
  ...(songsGroupedByLang.Anderstalig ?? []),
];
---

<Layout title={title}>
  <CodexChallengePage
    dutchSongs={songsGroupedByLang.Nederlands ?? []}
    frenchSongs={songsGroupedByLang.Frans ?? []}
    germanSongs={songsGroupedByLang.Duits ?? []}
    otherSongs={otherSongs}
  />
</Layout>

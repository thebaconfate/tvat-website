---
import Layout from "../../layouts/Layout.astro";
import CodexChallengePage from "@/components/web/codex-challenge/CodexChallengePage.astro";
import { getCollection } from "astro:content";

const title = "Codex Challenge";
const songs = await getCollection("songs");
const groupedSongs = Object.groupBy(songs, (song) => song.data.language);
---

<Layout title={title}>
  <CodexChallengePage
    dutchSongs={groupedSongs.Nederlands?.map((songs) => songs.data) ?? []}
    frenchSongs={groupedSongs.Frans?.map((songs) => songs.data) ?? []}
    germanSongs={groupedSongs.Duits?.map((songs) => songs.data) ?? []}
    otherSongs={groupedSongs.Anderstalig?.map((songs) => songs.data) ?? []}
  />
</Layout>

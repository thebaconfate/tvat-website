---
import Checkbox from "@/components/krambambouli/dashboard/checkbox/Checkbox";
import { formatDate } from "@/lib/domain/datetime";
import { krambambouliService } from "@/lib/services/krambambouli";
import { formatCurrency, getLocale } from "@/lib/utils";

const { locals, request } = Astro;
const locale = getLocale(request);

const page = await krambambouliService.getOrders();
---

<div class="filters"></div>
<table>
  <thead>
    <tr>
      <th></th>
      <th>Order #</th>
      <th>Datum</th>
      <th>Naam</th>
      <th>Prijs</th>
      <th>Ontvangen</th>
      <th>Betaald</th>
    </tr>
  </thead>
  <tbody>
    {
      page.content.map((order) => (
        <tr>
          <td />
          <td>{order.orderNumber}</td>
          <td>{formatDate(order.createdAt, locale, {})}</td>
          <td>{`${order.firstName} ${order.lastName}`}</td>
          <td>{formatCurrency(order.totalOwed / 100)}</td>
          <td>{order.received ? "Ja" : "Nee"}</td>
          <td>{order.paid ? "Ja" : "Nee"}</td>
        </tr>
      ))
    }
    <tr>
      <td></td>
      <td class="name">Totaal</td>
      <td></td>
      <td></td>
      <td
        >{
          formatCurrency(
            page.content.reduce((acc, order) => acc + order.totalOwed, 0) / 100,
          )
        }</td
      >
      <td></td>
    </tr>
  </tbody>
</table>
<style>
  table {
    margin: 1rem;
    border-collapse: collapse;
  }

  th,
  td {
    text-align: left;
    padding: 0.6rem 0.8rem;
    border: 1px solid transparent;
    color: black;
  }

  tr:nth-child(even) {
    background-color: rgba(222, 208, 225, 1);
  }

  .name {
    font-weight: bold;
  }
</style>

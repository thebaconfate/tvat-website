# Copy to .env (scripts/setup.sh does this for you). .env is gitignored: never commit it.

# Local database (Docker, see docker-compose.yml). setup.sh generates DB_PASSWORD.
DB_HOST=localhost
DB_PORT=5432
DB_USER=tvat
DB_PASSWORD=
DB_DATABASE=tvat

# Emails (order confirmations, password resets) are sent with Resend. The site runs without
# a real key; sending an email then fails and is logged.
RESEND_API_KEY=re_development_placeholder
# Domain the emails are sent from (no-reply@DOMAIN)
DOMAIN=example.com
# Where contact form messages go
VATMAIL=dev@example.com

# Payment details shown in the order confirmation email
IBAN=BE00 0000 0000 0000
BIC=GEBABEBB
ACCOUNTHOLDER="'t VAT"

# Creating the first (root) user: see the README. Leave empty to disable that route.
BOOTSTRAP_TOKEN=

# Optional, for scripts/db-pull.sh (copying production into your local database):
# RAILWAY_DB_SERVICE=Postgres
# RAILWAY_DB_ENV=production
